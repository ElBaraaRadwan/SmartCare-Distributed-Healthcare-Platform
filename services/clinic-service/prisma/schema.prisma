datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// From auth-service (read-only for clinic-service)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(PATIENT)
  firstName String?
  lastName  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  PATIENT
  DOCTOR
  PHARMACIST
  ADMIN
}

// Clinic-service models
model Appointment {
  id             String              @id @default(uuid())
  patientId      String
  doctorId       String
  scheduledAt    DateTime
  status         AppointmentStatus   @default(PENDING)
  notes          String?
  consultation   Consultation?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledAt])
  @@index([status])
  @@map("appointments")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Consultation {
  id            String       @id @default(uuid())
  appointmentId String       @unique
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  notes         String
  duration      Int?
  videoUrl      String?
  createdAt     DateTime     @default(now())

  @@map("consultations")
}