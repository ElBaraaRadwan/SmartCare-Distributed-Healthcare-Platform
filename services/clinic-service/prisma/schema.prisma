datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// From auth-service (read-only for clinic-service)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(PATIENT)
  firstName String?
  lastName  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  PATIENT
  DOCTOR
  PHARMACIST
  ADMIN
}

// Clinic-service models
model Appointment {
  id             String              @id @default(uuid())
  patientId      String
  doctorId       String
  scheduledAt    DateTime
  status         AppointmentStatus   @default(PENDING)
  notes          String?
  consultation   Consultation?
  files          File[]              // Associated files
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledAt])
  @@index([status])
  @@map("appointments")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Consultation {
  id            String       @id @default(uuid())
  appointmentId String       @unique
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  notes         String
  duration      Int?
  videoUrl      String?
  files         File[]       // Associated files
  createdAt     DateTime     @default(now())

  @@map("consultations")
}

// ✅ PHI Access Audit Logging
model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  userEmail      String?
  userRole       String?
  action         String
  resource       String
  ipAddress      String?
  userAgent      String?
  requestBody    Json?
  responseStatus Int?
  timestamp      DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
  @@index([resource])
  @@map("audit_logs")
}

// ✅ Medical Document File Storage
model File {
  id              String      @id @default(uuid())
  filename        String
  originalName    String
  mimeType        String
  size            Int
  hash            String      // SHA-256 hash for integrity verification
  bucket          String      @default("smartcare-medical-docs")
  key             String      // MinIO object key
  uploadedBy      String      // User ID who uploaded
  uploadedByRole  String      // User role for audit
  patientId       String?     // Associated patient (for access control)
  appointmentId   String?     // Associated appointment
  consultationId  String?     // Associated consultation
  category        FileCategory @default(MEDICAL_DOCUMENT)
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  deletedBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])
  consultation    Consultation? @relation(fields: [consultationId], references: [id])

  @@index([uploadedBy])
  @@index([patientId])
  @@index([appointmentId])
  @@index([consultationId])
  @@index([category])
  @@index([isDeleted])
  @@index([createdAt])
  @@map("files")
}

enum FileCategory {
  MEDICAL_DOCUMENT
  LAB_RESULT
  PRESCRIPTION_IMAGE
  INSURANCE_CARD
  OTHER
}