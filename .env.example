# SmartCare Environment Variables
# Copy this to .env and update with your values

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://smartcare:smartcare_dev_pass@localhost:5432/smartcare_dev"
POSTGRES_USER=smartcare
POSTGRES_PASSWORD=smartcare_dev_pass
POSTGRES_DB=smartcare_dev

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-strong-redis-password-change-in-production

# ============================================
# MINIO (S3-Compatible Storage)
# ============================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=prescriptions
MINIO_SECURE=false

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-different-refresh-token-secret-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=1h        # ✅ Reduced from 7d
JWT_REFRESH_EXPIRES_IN=24h      # ✅ Reduced from 7d

# ============================================
# EVENT SECURITY
# ============================================
EVENT_ENCRYPTION_SECRET=your-32-char-encryption-secret-key-for-events
EVENT_HMAC_SECRET=your-hmac-secret-for-event-signing-verification

# ============================================
# SERVICE URLS (Development)
# ============================================
AUTH_SERVICE_URL=http://localhost:4001
CLINIC_SERVICE_URL=http://localhost:4002
PRESCRIPTION_SERVICE_URL=http://localhost:4003
PHARMACY_SERVICE_URL=http://localhost:4004
PAYMENTS_SERVICE_URL=http://localhost:4005
NOTIFICATION_SERVICE_URL=http://localhost:4006
OCR_SERVICE_URL=http://localhost:8000

# ============================================
# STRIPE (Payment Gateway)
# ============================================
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_TEST_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# ============================================
# EMAIL (SMTP - Use Mailtrap for development)
# ============================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-pass
SMTP_FROM=noreply@smartcare.com

# ============================================
# TWILIO (SMS - Optional)
# ============================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
